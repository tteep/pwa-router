{
  "expo": {
    "name": "Gatsby Router",
    "slug": "gatsby-router",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-kki.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/app-icon-kki.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gatsbyrouter.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Gatsby Router uses Face ID to securely authenticate you before routing intents."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-kki.png",
        "backgroundColor": "#0D1117"
      },
      "package": "com.gatsbyrouter.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.QUERY_ALL_PACKAGES"
      ],
      "intentFilters": [
        {
          "action": "android.intent.action.VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https"
            },
            {
              "scheme": "http"
            }
          ],
          "category": [
            "android.intent.category.DEFAULT",
            "android.intent.category.BROWSABLE"
          ]
        },
        {
          "action": "android.intent.action.SENDTO",
          "data": [
            {
              "scheme": "mailto"
            }
          ],
          "category": [
            "android.intent.category.DEFAULT"
          ]
        },
        {
          "action": "android.intent.action.DIAL",
          "data": [
            {
              "scheme": "tel"
            }
          ],
          "category": [
            "android.intent.category.DEFAULT"
          ]
        },
        {
          "action": "android.intent.action.VIEW",
          "data": [
            {
              "scheme": "geo"
            }
          ],
          "category": [
            "android.intent.category.DEFAULT"
          ]
        },
        {
          "action": "android.intent.action.SEND",
          "data": [
            { "mimeType": "text/plain" },
            { "mimeType": "image/*" }
          ],
          "category": [
            "android.intent.category.DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/newly.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      "expo-local-authentication"
    ],
    "scheme": "gatsbyrouter",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "supabaseUrl": "https://eomrynglzkjeygguvtyw.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVvbXJ5bmdsemtqZXlnZ3V2dHl3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODYwNDU0MDEsImV4cCI6MjEwMTYyMTQwMX0.K-22c2ypgHJZbrCCsLjSy1qtrS12oNKIKXhC528CA5o"
    }
  }
}